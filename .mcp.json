{
  "mcpServers": {
    "supabase": {
      "type": "url",
      "url": "https://mcp.supabase.com/mcp",
      "description": "Supabase DB access \u2014 project database"
    },
    "github": {
      "type": "url",
      "url": "https://mcp.github.com/mcp",
      "description": "GitHub \u2014 The-MDC org access"
    },
    "alchemy": {
      "type": "url",
      "url": "https://mcp.alchemy.com/mcp",
      "description": "Alchemy MCP \u2014 blockchain data, NFT APIs, AA-SDK"
    },
    "figma": {
      "type": "url",
      "url": "https://mcp.figma.com/mcp",
      "description": "Figma \u2014 design assets, mockups"
    },
    "gmail": {
      "type": "url",
      "url": "https://gmail.mcp.claude.com/mcp",
      "description": "Gmail \u2014 investor and partner email"
    },
    "google-drive": {
      "type": "url",
      "url": "https://drive.mcp.claude.com/mcp",
      "description": "Google Drive \u2014 shared docs and decks"
    },
    "netlify": {
      "type": "url",
      "url": "https://netlify-mcp.netlify.app/mcp",
      "description": "Netlify \u2014 deployment and hosting"
    },
    "hermes": {
      "command": "hermes",
      "args": [
        "${HERMES_SKILLS_SERVER}"
      ],
      "tools": [
        "list_skills",
        "get_skill",
        "search_skills"
      ]
    },
    "hermes-council": {
      "command": "${HERMES_COUNCIL_LAUNCHER}",
      "args": [],
      "tools": [
        "council_review",
        "council_perspectives"
      ]
    },
    "codex-mcp": {
      "command": "${HERMES_CODEX_LAUNCHER}",
      "args": [],
      "tools": [
        "codex_exec",
        "codex_status"
      ]
    },
    "cloudflare": {
      "url": "https://mcp.cloudflare.com/mcp",
      "tools": [
        "workers_list",
        "workers_get",
        "kv_list"
      ]
    },
    "submcp": {
      "url": "https://mcp.submcp.com/mcp",
      "tools": [
        "unfiltered: true"
      ]
    }
  }
}